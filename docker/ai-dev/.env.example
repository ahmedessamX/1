# ─────────────────────────────────────────────────────────────────────────────
# AI Dev Container — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_YOUR_TOKEN_HERE
HF_HOME=/workspace/.cache/huggingface

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-YOUR_KEY_HERE
OPENAI_ORG_ID=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_KEY_HERE

# ── Weights & Biases ──────────────────────────────────────────────────────────
WANDB_API_KEY=YOUR_KEY_HERE
WANDB_PROJECT=my-ai-project
WANDB_ENTITY=

# ── Jupyter ───────────────────────────────────────────────────────────────────
# Leave empty to disable token authentication (only safe on localhost)
JUPYTER_TOKEN=

# ── Workspace directory on the host (mapped to /workspace in the container) ───
# Windows path example: WORKSPACE_DIR=D:/projects
# WSL path example:     WORKSPACE_DIR=/mnt/d/projects
WORKSPACE_DIR=../../

# ── Database (used only when running with --profile db) ──────────────────────
POSTGRES_DB=aidev
POSTGRES_USER=aidev
POSTGRES_PASSWORD=change_me_please
